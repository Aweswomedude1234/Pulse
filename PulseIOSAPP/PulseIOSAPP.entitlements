<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Critical Alerts break through the mute switch, volume, and Focus/Do Not
	  Disturb at full volume — essential for a deaf-accessibility safety app.
	  This entitlement ONLY takes effect after Apple approves the request at
	  https://developer.apple.com/contact/request/notifications-critical-alerts-entitlement
	  Until then, device code-signing will FAIL with a provisioning error.
	  If you need to build to a device before approval, remove this key.
	-->
	<key>com.apple.developer.usernotifications.critical-alerts</key>
	<true/>
</dict>
</plist>
